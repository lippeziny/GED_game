PORT=3000
NODE_ENV=production
# Onde as sessões são gravadas (use um disco persistente em produção)
DATA_DIR=./data
# PERSISTENCE=off  -> desliga a gravação em disco
# Pontos por colocação (1º,2º,3º...). Depois da lista, cai 50 por colocação, mínimo 100.
PONTOS_POR_COLOCACAO=1000,900,800,700,600
# Só se o front-end ficar em outro domínio (separado por vírgula)
# CLIENT_ORIGIN=https://seu-front.exemplo.com
# TRUST_PROXY=1 (padrão em produção; necessário atrás de proxy para limitar tentativas por IP)
# Pontos descontados por documento errado aberto
PENALIDADE_POR_ERRO=50
# Busca de fotos de perfil (Openverse, sem chave). Para incluir o Wikimedia Commons: IMAGENS_PROVEDORES=openverse,wikimedia
# IMAGENS_BUSCA=off  -> desativa a busca (continua possível enviar foto do aparelho)
IMAGENS_PROVEDORES=openverse
